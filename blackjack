#include <stdio.h>
#include <stdlib.h>
#include <string.h> // Added for strcmp()
#include <time.h>

typedef struct {
    int number; // Number of the card (1-10)
    char suit[10];  // Suit of the card (e.g., "Hearts", "Diamonds", etc.)
} Card;

// Function prototypes
Card dealCard();
int calculateHand(Card hand[], int numCards);
void printHand(Card hand[], int numCards, int hideFirstCard);

int main() {
    srand(time(NULL)); // Seed random number generator

    Card playerHand[10]; // Array to store player's cards
    Card dealerHand[10]; // Array to store dealer's cards
    int numPlayerCards = 0; // Number of player's cards
    int numDealerCards = 0; // Number of dealer's cards
    int playerMoney = 1000; // Initial amount of money for the player
    int bet;

    printf("Welcome to Blackjack!\n\n");

    while (playerMoney > 0) {
        printf("You have $%d.\n", playerMoney);
        printf("Place your bet (0 to quit): ");
        scanf("%d", &bet);
        if (bet == 0) {
            printf("Thanks for playing! You leave with $%d.\n", playerMoney);
            break;
        }
        if (bet > playerMoney) {
            printf("You don't have enough money. Please place a lower bet.\n");
            continue;
        }

        // Reset hands
        numPlayerCards = 0;
        numDealerCards = 0;

        // Deal initial cards
        playerHand[numPlayerCards++] = dealCard();
        playerHand[numPlayerCards++] = dealCard();
        dealerHand[numDealerCards++] = dealCard();
        dealerHand[numDealerCards++] = dealCard();

        printf("\n");

        // Player's turn
        printf("Your hand: ");
        printHand(playerHand, numPlayerCards, 0); // Show all player's cards
        printf("Dealer's hand: ");
        printHand(dealerHand, numDealerCards, 1); // Hide dealer's first card
        printf("\n");

        // Player's actions
        char choice[10];
        while (1) {
            printf("Do you want to hit or stand? ");
            scanf("%s", choice);

            if (strcmp(choice, "hit") == 0) { // Hit
                playerHand[numPlayerCards++] = dealCard();
                printf("Your hand: ");
                printHand(playerHand, numPlayerCards, 0);
                if (calculateHand(playerHand, numPlayerCards) > 21) {
                    printf("Bust! You lose $%d.\n", bet);
                    playerMoney -= bet;
                    break;
                }
            } else if (strcmp(choice, "stand") == 0) { // Stand
                break;
            } else {
                printf("Invalid choice. Please try again.\n");
            }
        }

        if (calculateHand(playerHand, numPlayerCards) > 21) {
            continue;
        }

        // Dealer's turn
        printf("Dealer's turn:\n");
        printf("Dealer's hand: ");
        printHand(dealerHand, numDealerCards, 0); // Show all dealer's cards
        while (calculateHand(dealerHand, numDealerCards) < 17) {
            dealerHand[numDealerCards++] = dealCard();
            printf("Dealer hits: ");
            printHand(dealerHand, numDealerCards, 0);
        }

        // Determine winner
        int playerScore = calculateHand(playerHand, numPlayerCards);
        int dealerScore = calculateHand(dealerHand, numDealerCards);

        printf("\n");
        printf("Your score: %d\n", playerScore);
        printf("Dealer's score: %d\n", dealerScore);

        if (dealerScore > 21 || playerScore > dealerScore) {
            printf("You win $%d!\n", bet);
            playerMoney += bet;
        } else if (dealerScore > playerScore) {
            printf("Dealer wins. You lose $%d.\n", bet);
            playerMoney -= bet;
        } else {
            printf("It's a tie! Your bet is returned.\n");
        }

        printf("\n");
    }

    return 0;
}

// Function to deal a random card (1 to 10)
Card dealCard() {
    Card newCard;
    newCard.number = rand() % 10 + 1;
    // Array of suits
    char suits[4][10] = {"Hearts", "Diamonds", "Clubs", "Spades"};
    // Randomly select a suit
    int randomIndex = rand() % 4;
    sprintf(newCard.suit, "%s", suits[randomIndex]);
    return newCard;
}

// Function to calculate the total value of a hand
int calculateHand(Card hand[], int numCards) {
    int sum = 0;
    int numAces = 0;
    for (int i = 0; i < numCards; i++) {
        if (hand[i].number == 1) {
            numAces++;
            sum += 11;
        } else if (hand[i].number > 10) {
            sum += 10;
        } else {
            sum += hand[i].number;
        }
    }
    while (sum > 21 && numAces > 0) {
        sum -= 10;
        numAces--;
    }
    return sum;
}

// Function to print a hand of cards
void printHand(Card hand[], int numCards, int hideFirstCard) {
    for (int i = 0; i < numCards; i++) {
        if (i == 0 && hideFirstCard) {
            printf("[Hidden Card] "); // Hide the first card
        } else {
            printf("[%d %s] ", hand[i].number, hand[i].suit);
        }
    }
    printf("\n");
}
